# Copy to apps/api/.env and apps/web/.env.local

# PostgreSQL
DATABASE_URL=postgresql://club:club@localhost:5432/clubportal

# Origins
WEB_ORIGIN=http://localhost:3000
API_PORT=4000

# JWT — replace in any shared environment
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret

# Cookies. Localhost ports share a host, so Lax works in dev.
# In production on HTTPS set COOKIE_SECURE=true.
# If the web and API are different sites, set COOKIE_SAMESITE=none and COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.example.com

# Gmail via Nodemailer (Google account app password)
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM=

# Razorpay. Amounts on clubs are minor units (paise for INR).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Storage: local or s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# Web Push (optional). Leave blank to store in-app notifications only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hq@clubportal.local

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
